# Production env for the VPS. Copy to /opt/ticketing/backend.env and fill in.
# Owner root:jenkins, mode 640 (setup-vps.sh does this). Never commit the real file.
# PG_HOST / PG_PORT / PORT / UPLOAD_DIR are forced by docker-compose.prod.yml.

NODE_ENV=production

# Same-origin setup via host nginx; add https://your.domain once you have one
ALLOWED_ORIGINS=http://201.18.207.174

# Auth - generate with: openssl rand -hex 48
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1d

# Postgres (container is created with these on first start)
PG_USERNAME=ticketing
PG_PASSWORD=CHANGE_ME
PG_DB=ticketing_system
PG_SSL=false

# Generate with: openssl rand -hex 32
EMAIL_ENCRYPTION_KEY=CHANGE_ME
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Firebase push notifications (optional). Put the key file at
# /opt/ticketing/secrets/firebase-service-account.json and use the container path:
# FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# External master-data API
EXTERNAL_API_BASE_URL=http://43.204.141.252:3013/api/
EXTERNAL_API_TOKEN=CHANGE_ME
