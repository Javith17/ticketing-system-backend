# Copy to /opt/ticketing/traefik/.env (install-traefik.sh does this) and fill in.
# Every hostname below needs a DNS A record pointing at the VPS IP.

# Let's Encrypt account email (expiry warnings go here)
ACME_EMAIL=you@example.com

# The app: UI at https://APP_DOMAIN/, API at https://APP_DOMAIN/api/
APP_DOMAIN=tickets.example.com

# Jenkins UI + GitHub webhook
CI_DOMAIN=ci.tickets.example.com

# Traefik Manager web UI: routes, replica health, certificates, access logs.
# (Replaces Traefik's built-in dashboard; has its own login + 2FA.)
TM_DOMAIN=traefik.tickets.example.com

# Credentials Traefik Manager uses to read the Traefik API.
# Leave empty: install-traefik.sh generates them.
TRAEFIK_API_USER=tm
TRAEFIK_API_PASSWORD=
TRAEFIK_API_AUTH=
