# Runtime environment
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Postgres
PG_HOST=localhost
PG_PORT=5432
PG_USERNAME=
PG_PASSWORD=
PG_DB=
PG_SSL=false

# Local file storage for ticket/NCR image uploads
UPLOAD_DIR=./uploads

# Firebase Admin SDK service account (push notifications) - inline JSON or a
# path to the downloaded key file. Leave both unset to disable push
# notifications (calls will log a warning and no-op).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Email (NCR/ticket notifications + Settings > Email Settings)
# Symmetric key used to AES-256-GCM encrypt the saved email account password
# at rest. Required before anyone can save or send from Email Settings -
# the app will not fail to start without it, but save/send calls will error
# until it is set. Use a long random string.
EMAIL_ENCRYPTION_KEY=

# SMTP host/port used to send email - defaults to Gmail (smtp.gmail.com:587,
# STARTTLS) since the UI only collects an email address + password. Override
# if using a different provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# External master-data API (locations/sections/poles). Falls back to the
# values below if unset.
EXTERNAL_API_BASE_URL=http://43.204.141.252:3013/api/
EXTERNAL_API_TOKEN=ZDh7rtXw-COFhoipuhLK_NeCLCcGrEwwyXZ6PHl9uNs
